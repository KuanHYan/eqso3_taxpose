#!/bin/bash
#PBS -N train_ndf                      # 作业名称
#PBS -l nodes=1:ppn=32                 # 申请1个节点，8个CPU核心（可根据需要调整）
#PBS -l gpus=2                         # 申请2块GPU（可根据需要改为1或2）
#PBS -q gpu                            # 指定GPU队列
#PBS -l walltime=48:00:00              # 最大运行时间（根据训练时长调整）
#PBS -j oe                             # 合并标准输出和错误输出
#PBS -o train_output.log               # 输出日志文件
#PBS -V

# =================== 用户自定义参数（每次运行前可修改） ===================
GPU_INDEX="0,1"          # 使用的GPU设备编号，逗号分隔，与gpus数量一致
GPU_NUM=2                # GPU总数
DATA_POINTS_N=1024
EMB_DIM=384
POINTS=1024
TEST_MODE="False"         # 测试模式
ENCODEING="False"
WANDB_NAME="debug_distributed_training"   # wandb任务名称
RESUME_CKPT=""           # 若从断点恢复，填写checkpoint路径，否则留空
# ========================================================================

# 进入提交作业时所在的目录（通常是你存放脚本和数据的地方）
cd $PBS_O_WORKDIR

# -------------------- 1. 加载系统和CUDA环境 --------------------
module load gcc/13.2                    # 加载新版GCC（编译需要）
export CUDA_HOME=/usr/local/cuda-12.4   # 根据手册指定CUDA路径
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
export NUM_NODES=1

# -------------------- 2. 激活你的conda环境 --------------------
source ~/miniconda3/etc/profile.d/conda.sh
conda activate yankh_pose                    # 替换成你自己的环境名

# -------------------- 3. 设置GPU可见性 --------------------
export CUDA_VISIBLE_DEVICES=$GPU_INDEX
export PYTEST_CURRENT_TEST=$TEST_MODE  # 用于调试标志

# -------------------- 4. 启动分布式训练 --------------------
# 使用 torchrun（PyTorch 自带），单节点多GPU
# 若 torchrun 不可用，可改用 python -m torch.distributed.run
python "./scripts/train_residual_flow.py" \
    --config-name train_ndf \
    job_type="train_taxpose" \
    data_root="${PBS_O_WORKDIR}/data/ideal_pair_models" \
    training.max_epochs=500 \
    training.check_val_every_n_epoch=1 \
    training.batch_size=40 \
    training.lr=2.5e-4 \
    training.min_lr=2.5e-5 \
    training.warmup_ratio=0.025 \
    training.weight_decay=1e-4 \
    training.precision='32' \
    training.scheduler=linear \
    training.num_gpus=$GPU_NUM \
    training.point_cloud_loss="MSE" \
    dataset@dm=tax_pose \
    dm.test_folder=val_data \
    dm.train_dset.dataset_size=40000 \
    dm.train_dset.demo_dset.num_demo=40000 \
    dm.train_dset.demo_dset.min_num_points=$DATA_POINTS_N \
    dm.train_dset.demo_dset.occlusion_cfg.random_dropout=False \
    dm.train_dset.demo_dset.occlusion_cfg.anisotropic_scaling=False \
    dm.train_dset.demo_dset.occlusion_cfg.gaussian_noise=False \
    dm.train_dset.demo_dset.occlusion_cfg.occlusion_class=0 \
    dm.train_dset.anchor_rot_sample_method=axis_angle \
    dm.train_dset.anchor_rotation_variance=3.141592653 \
    model.model_type=cascade_flow_transformer \
    model.freeze_embnn=True \
    model.dropout=0.1 \
    model.n_blocks=1 \
    model.attn_mode="linear" \
    model.pos_encoding=$ENCODEING \
    model.fine_tune=False \
    model.num_refine_steps=0 \
    model.refine_hidden_dim=128 \
    model.stage_num=2 \
    model.encoder.name=raw_dgcnn \
    model.encoder.norm=BN \
    model.encoder.emb_dims=$EMB_DIM \
    model.encoder.pos_encoding=$ENCODEING \
    model.encoder.output_num=$POINTS \
    model.head.head_type=residual \
    model.head.project_corrs=True \
    model.head.project_corrs_mode="moe" \
    model.head.norm=LN \
    model.head.head_bias=False \
    model.head.residual_on=True \
    model.head.pred_weight=True \
    model.head.reparam=False \
    wandb.name=$WANDB_NAME \
    'model.pretraining.action.ckpt_path="logs/pretrain_embedding/best_cpkg/dgcnn_v2.ckpt"' \
    'model.pretraining.anchor.ckpt_path="logs/pretrain_embedding/best_cpkg/dgcnn_v2.ckpt"' \
    wandb.offline=True \
    debug=False \
    eval=False \
    resume_ckpt=$RESUME_CKPT

